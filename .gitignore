# Gradle files
.gradle/
build/
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Native build outputs (produced by buildNativeExploit / buildNativePageCache / buildNativeGpu /
# buildNativePct)
/native/**/*.o
/native-or/*.o
/native-or/splicehelper
/native-gpu/**/*.o
/native-pct/**/*.o

# The four payload engines are committed prebuilt so the app builds without an NDK, which Google
# does not publish for aarch64 hosts. They were extracted from the published release APK and only
# need re-checking in when native/ changes on an x86_64 machine building them from source.
!/app/src/main/jniLibs/arm64-v8a/libghostlock.so
!/app/src/main/jniLibs/arm64-v8a/libopenroot.so
!/app/src/main/jniLibs/arm64-v8a/libopenbootstrap.so
!/app/src/main/jniLibs/arm64-v8a/libcheese-quest.so
!/app/src/main/jniLibs/arm64-v8a/libcheese-snapdragon.so
!/app/src/main/jniLibs/arm64-v8a/libpct-opace6.so

# Everything else under jniLibs is produced by the dependency graph or copied in for the wired
# vivo flow, so it stays out of the repository.
/app/src/main/jniLibs/**/libksu_*.so
/app/src/main/jniLibs/**/libbs.so
